# ==============================================================================
# Homelab Zero-Trust: Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# --- VPN Provider Configuration (Gluetun) ---
# Supported providers: pia, mullvad, protonvpn, surfshark, etc.
VPN_SERVICE_PROVIDER=pia
VPN_TYPE=openvpn
OPENVPN_USER=your_vpn_username
OPENVPN_PASSWORD=your_vpn_password

# --- Network & Tailscale Mesh IPs ---
# Replace with the assigned 100.x.x.x IPs from your Tailscale network
TAILSCALE_ORACLE_IP=100.100.100.100
TAILSCALE_WORKER_IP=100.100.100.101

# --- Dynamic DNS & Domain (DuckDNS / NPM) ---
DUCKDNS_SUBDOMAIN=your_subdomain
DUCKDNS_TOKEN=your_duckdns_token_here
DOMAIN_NAME=your_subdomain.duckdns.org

# --- Media Management APIs (*arr Stack) ---
# Tailscale internal endpoint + API Keys found in Settings -> General
RADARR_URL=http://100.100.100.100:7878
RADARR_API_KEY=your_radarr_api_key_here
SONARR_URL=http://100.100.100.100:8989
SONARR_API_KEY=your_sonarr_api_key_here

# --- AI Integration (Open-WebUI / OpenAI / NVIDIA NIM) ---
OPENAI_API_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=your_ai_api_key_here

# --- Local PC Automation & Wake-on-LAN ---
PC_MAC=00:11:22:33:44:55
PC_IP=192.168.0.100
PC_PORT=9876
PC_BROADCAST=192.168.0.255
PC_IFACE=wlan0

# --- General Container Settings ---
PUID=1000
PGID=1000
TZ=America/Sao_Paulo
