# --- Secrets & Environment ---
.env
.env.local
.env.*.local
*.key
*.pem
*.crt
*.id_rsa*
.ssh/
strikes.json

# --- System & Local Directories ---
.config/
.local/
.termux/
backups/
storage/
mappings/

