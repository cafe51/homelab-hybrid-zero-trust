0*.md
03_docker-compose_oracle_FINAL.yml
IDEA.md
todoHomelab.txt

# --- Logs & Dynamic State ---
*.log
*.lock
*.sock
*.pid

# --- Archives & Snapshots ---
*.tar.gz
*.tar
*.zip
*.gz
*.7z

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

